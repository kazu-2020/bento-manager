<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
  <div class="card bg-base-100 shadow-sm">
    <div class="card-body p-4">
      <p class="text-sm text-base-content/60"><%= t(".total_quantity") %></p>
      <p class="text-2xl font-bold"><%= total_quantity %><span class="text-base font-normal"><%= t(".quantity_unit") %></span></p>
    </div>
  </div>
  <div class="card bg-base-100 shadow-sm">
    <div class="card-body p-4">
      <p class="text-sm text-base-content/60"><%= t(".total_transactions") %></p>
      <p class="text-2xl font-bold"><%= total_transactions %><span class="text-base font-normal"><%= t(".transactions_unit") %></span></p>
    </div>
  </div>
  <div class="card bg-base-100 shadow-sm">
    <div class="card-body p-4">
      <p class="text-sm text-base-content/60"><%= t(".location") %></p>
      <p class="text-2xl font-bold"><%= location.name %></p>
    </div>
  </div>
</div>
