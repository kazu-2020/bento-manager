<div class="flex items-start justify-between gap-2 mb-3">
  <h3 class="card-title text-base"><%= t(".title") %></h3>
  <div class="flex flex-wrap items-center justify-end gap-x-3 gap-y-1 text-[10px] text-base-content/50">
    <div class="flex items-center gap-1">
      <span><%= t(".legend_scale") %></span>
      <span><%= t(".legend_low") %></span>
      <% HEAT_COLORS.values_at(1, 2, 3, 4, 5).each do |cls| %>
        <div class="w-3 h-3 rounded-sm <%= cls.split.first %>"></div>
      <% end %>
      <span><%= t(".legend_high") %></span>
    </div>
    <div class="flex items-center gap-1">
      <span class="<%= NO_REMAINING_STOCK_MARKER %>"></span>
      <span><%= t(".legend_no_remaining_stock") %></span>
    </div>
  </div>
</div>

<div class="grid grid-cols-7 gap-1">
  <% WEEKDAY_NAMES.each do |name| %>
    <div class="text-center text-xs text-base-content/50 pb-1"><%= name %></div>
  <% end %>

  <% weeks.each do |week| %>
    <% week.each do |date| %>
      <% if in_month?(date) && daily_quantities[date] %>
        <%= link_to daily_detail_path(date),
              class: "block rounded-lg aspect-square p-1.5 #{heat_class(date)} hover:ring-2 hover:ring-primary",
              data: { turbo_frame: "sales_history_daily_detail" } do %>
          <div class="flex items-start justify-between gap-0.5">
            <span class="text-xs font-bold"><%= date.day %></span>
            <% if no_remaining_stock?(date) %>
              <span class="<%= NO_REMAINING_STOCK_MARKER %> mt-0.5 shrink-0 ring-1 ring-base-100/60"
                    title="<%= t('.no_remaining_stock') %>"></span>
            <% end %>
          </div>
          <div class="text-[10px] opacity-80 mt-auto"><%= quantity_display(date) %></div>
        <% end %>
      <% elsif in_month?(date) %>
        <%# 販売データなし = 休日とみなす（訪問販売で販売ゼロは現実的にないため） %>
        <div class="rounded-lg aspect-square p-1.5 border-2 border-dashed border-base-300">
          <div class="text-xs text-base-content/30"><%= date.day %></div>
          <div class="text-[10px] text-base-content/20 mt-auto"><%= t(".closed") %></div>
        </div>
      <% else %>
        <div></div>
      <% end %>
    <% end %>
  <% end %>
</div>
