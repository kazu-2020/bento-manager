<div class="grid grid-cols-3 gap-4 text-center">
  <div>
    <p class="text-xs text-base-content/60"><%= t(".total") %></p>
    <p class="text-2xl font-bold"><%= total_quantity %><span class="text-base font-normal"><%= t(".quantity_unit") %></span></p>
  </div>
  <div>
    <p class="text-xs text-base-content/60"><%= t(".daily_average") %></p>
    <p class="text-2xl font-bold"><%= daily_average %><span class="text-base font-normal"><%= t(".quantity_unit") %></span></p>
  </div>
  <div>
    <p class="text-xs text-base-content/60"><%= t(".best_day") %></p>
    <p class="text-2xl font-bold"><% if best_day %><%= best_day[:quantity] %><span class="text-base font-normal"><%= t(".quantity_unit") %></span><% else %><%= NO_DATA %><% end %></p>
    <% if best_day %>
      <p class="text-[10px] text-base-content/50"><%= best_day_label %></p>
    <% end %>
  </div>
</div>
