<%= helpers.turbo_frame_tag "sales_analysis_summary" do %>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    <%# 総販売数 %>
    <div class="card bg-base-100 shadow-sm">
      <div class="card-body p-4">
        <p class="text-xs text-base-content/60"><%= t(".total_label") %></p>
        <p class="text-3xl font-bold"><%= total_quantity %><span class="text-base font-normal"><%= t(".quantity_unit") %></span></p>
        <p class="text-xs text-base-content/50"><%= t(".total_amount_caption", amount: helpers.number_to_currency(total_amount)) %></p>
      </div>
    </div>

    <%# 関係者 %>
    <div class="card bg-base-100 shadow-sm">
      <div class="card-body p-4">
        <p class="text-xs text-base-content/60"><%= t(".staff_label") %></p>
        <p class="text-3xl font-bold text-staff"><%= data[:staff][:quantity] %><span class="text-base font-normal"><%= t(".quantity_unit") %></span></p>
        <p class="text-xs text-base-content/50"><%= t(".ratio_caption", ratio: staff_ratio, amount: helpers.number_to_currency(data[:staff][:amount])) %></p>
      </div>
    </div>

    <%# 一般 %>
    <div class="card bg-base-100 shadow-sm">
      <div class="card-body p-4">
        <p class="text-xs text-base-content/60"><%= t(".citizen_label") %></p>
        <p class="text-3xl font-bold text-citizen"><%= data[:citizen][:quantity] %><span class="text-base font-normal"><%= t(".quantity_unit") %></span></p>
        <p class="text-xs text-base-content/50"><%= t(".ratio_caption", ratio: citizen_ratio, amount: helpers.number_to_currency(data[:citizen][:amount])) %></p>
      </div>
    </div>
  </div>
<% end %>
