<%= helpers.turbo_frame_tag "sales_analysis_summary" do %>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    <%# 総販売数 %>
    <div class="card bg-base-100 shadow-sm">
      <div class="card-body p-4">
        <p class="text-xs text-base-content/60"><%= t(".total_label") %></p>
        <p class="text-3xl font-bold"><%= total_quantity %><span class="text-base font-normal"><%= t(".quantity_unit") %></span></p>
      </div>
    </div>

    <%# 関係者 %>
    <div class="card bg-base-100 shadow-sm">
      <div class="card-body p-4">
        <p class="text-xs text-base-content/60"><%= t(".staff_label") %></p>
        <p class="text-3xl font-bold text-staff"><%= quantities[:staff] %><span class="text-base font-normal"><%= t(".quantity_unit") %></span></p>
        <p class="text-xs text-base-content/50"><%= ratio_of(quantities[:staff]) %>%</p>
      </div>
    </div>

    <%# 一般 %>
    <div class="card bg-base-100 shadow-sm">
      <div class="card-body p-4">
        <p class="text-xs text-base-content/60"><%= t("enums.sale.customer_type.citizen") %></p>
        <p class="text-3xl font-bold text-citizen"><%= quantities[:citizen] %><span class="text-base font-normal"><%= t(".quantity_unit") %></span></p>
        <p class="text-xs text-base-content/50"><%= ratio_of(quantities[:citizen]) %>%</p>
      </div>
    </div>
  </div>
<% end %>
