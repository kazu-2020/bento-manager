<%= helpers.turbo_frame_tag "sales_analysis_ranking" do %>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <% customer_types.each do |customer_type| %>
      <% entries = data[customer_type] %>
      <div class="card bg-base-100 shadow-sm">
        <div class="card-body p-4">
          <div class="flex items-center justify-between">
            <h3 class="card-title text-base"><%= title_for(customer_type) %></h3>
            <div class="<%= icon_wrapper_class(customer_type) %>">
              <%= helpers.icon :users, size: :md, extra_class: icon_class(customer_type) %>
            </div>
          </div>
          <% if entries.empty? %>
            <p class="text-sm text-base-content/50 py-4"><%= t(".empty_message") %></p>
          <% else %>
            <table class="table table-sm">
              <thead>
                <tr>
                  <th class="w-8"></th>
                  <th><%= t(".catalog_header") %></th>
                  <th class="text-right"><%= t(".quantity_header") %></th>
                </tr>
              </thead>
              <tbody>
                <% entries.each_with_index do |entry, i| %>
                  <tr>
                    <td class="font-bold"><%= i + 1 %></td>
                    <td><%= entry[:catalog_name] %></td>
                    <td class="text-right font-bold"><%= entry[:quantity] %> <%= t(".quantity_unit") %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
