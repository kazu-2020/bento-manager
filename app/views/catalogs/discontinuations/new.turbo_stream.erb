<% discontinue_form = Catalogs::DiscontinueForm::Component.new(catalog: @catalog) %>

<%= modal_stream_show do %>
  <dialog class="modal">
    <div class="modal-box max-w-md">
      <h3 class="text-lg font-bold mb-4">
        <%= discontinue_form.modal_title %>
      </h3>

      <%= render "shared/modal_close_button" %>

      <%= render discontinue_form %>
    </div>

    <%= render "shared/modal_backdrop" %>
  </dialog>
<% end %>
