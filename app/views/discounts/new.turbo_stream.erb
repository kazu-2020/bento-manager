<% new_form = Discounts::NewForm::Component.new(discount: @discount) %>

<%= modal_stream_show do %>
  <dialog class="modal">
    <div class="modal-box max-w-lg">
      <%# turbo-frame の外に置くこと。中に入れるとフレーム差し替えで消える %>
      <form method="dialog" id="<%= modal_close_form_id %>">
        <button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2 modal-close-button" aria-label="<%= t('helpers.link.close', default: '閉じる') %>">
          <%= icon "close" %>
        </button>
      </form>

      <turbo-frame id="<%= Discounts::NewForm::Component::MODAL_FRAME_ID %>">
        <%= render partial: "modal_header", formats: [:html], locals: { new_form: new_form } %>
        <%= render new_form %>
      </turbo-frame>
    </div>

    <form method="dialog" class="modal-backdrop">
      <button><span class="sr-only">close</span></button>
    </form>
  </dialog>
<% end %>
